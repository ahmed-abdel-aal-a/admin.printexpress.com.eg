<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Forward all API calls directly to Laravel Backend (Port 8000)
    RewriteRule ^api/(.*)$ http://127.0.0.1:8000/api/$1 [P,L]

    # 2. Forward storage media calls directly to Laravel Backend (Port 8000)
    RewriteRule ^storage/(.*)$ http://127.0.0.1:8000/storage/$1 [P,L]

    # 3. Forward all other dashboard requests to Next.js Dashboard (Port 2050)
    RewriteCond %{REQUEST_URI} !^/api
    RewriteCond %{REQUEST_URI} !^/storage
    RewriteRule ^(.*)$ http://127.0.0.1:2050/$1 [P,L]
</IfModule>
